{
  "name": "tdw-chat",
  "version": "0.1.0",
  "description": "零依赖、框架无关的悬浮对话组件：一行 initChat() 在页面上挂出悬浮按钮与对话弹窗，ESM + CJS 双格式，UI 可用 CSS 完全重构。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "chat",
    "chat-widget",
    "floating-button",
    "livechat",
    "customer-support",
    "widget",
    "framework-agnostic",
    "zero-dependency",
    "typescript",
    "esm",
    "cjs",
    "对话组件",
    "客服"
  ],
  "homepage": "https://github.com/jianghongjiao/testDemo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianghongjiao/testDemo.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
